{
  "name": "mecanica-sonderegger-worker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mecanica-sonderegger-db",
    "db:init": "wrangler d1 execute mecanica-sonderegger-db --file=./schema.sql",
    "db:seed": "wrangler d1 execute mecanica-sonderegger-db --file=./seed.sql",
    "db:local-init": "wrangler d1 execute mecanica-sonderegger-db --local --file=./schema.sql",
    "db:local-seed": "wrangler d1 execute mecanica-sonderegger-db --local --file=./seed.sql",
    "hash": "node scripts/hash-password.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^7.0.2",
    "wrangler": "^3.86.0"
  }
}
